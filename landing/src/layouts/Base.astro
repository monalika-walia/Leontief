---
import "../styles/blog.css";
import { SITE, url } from "../data/site";
import { ldjson } from "../lib/ldjson";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage: string;
  ogImageAlt: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonld?: unknown[];
}

const {
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  ogType = "website",
  noindex = false,
  jsonld = [],
} = Astro.props;

const canonical = url(path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#17130c" />
    <meta name="color-scheme" content="dark" />

    <link
      rel="preload"
      href="/fonts/newsreader-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="alternate" type="application/rss+xml" title={SITE.blogTitle} href={url("/blog/rss.xml")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {jsonld.length > 0 && (
      <script type="application/ld+json" is:inline set:html={ldjson(...jsonld)} />
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="masthead__inner">
        <a class="mark" href={SITE.origin} aria-label="Leontief home">
          <span class="mark__glyph" aria-hidden="true"></span>
          <span class="mark__word">Leontief</span>
        </a>
        <nav class="masthead__nav" aria-label="Site">
          <a href="/blog">Blog</a>
          <a href={SITE.litepaper}>Litepaper</a>
          <a href={SITE.docs}>Docs</a>
          <a href={SITE.app}>App</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap colophon">
      <span>Leontief — a testnet prototype by {SITE.publisher}</span>
      <a href="/blog">Blog</a>
      <a href={SITE.litepaper}>Litepaper</a>
      <a href={SITE.docs}>Docs</a>
      <a href={SITE.github}>Source</a>
      <a href={url("/blog/rss.xml")}>RSS</a>
    </footer>
  </body>
</html>
